PORT=3000
NODE_ENV=development
DATABASE_URL=
# Genera uno con: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
# Orígenes permitidos por CORS, separados por coma. En dev puede quedar vacío
# (se permite cualquier localhost). En producción es obligatorio.
# 5173 = vite dev, 4173 = vite preview
# Ej: CORS_ORIGINS=https://app.pronoia.com,https://admin.pronoia.com
CORS_ORIGINS=http://localhost:5173,http://localhost:4173
# Username (sin @) del bot de Telegram usado para vincular proveedores/clientes
# y mandarles documentos/comprobantes. Ver clients/PRONOIA/integracion-telegram/PLAN.md
TELEGRAM_BOT_USERNAME=PronAIScrapbot
# Webhook de n8n que entrega el documento por Telegram (workflow "Enviar Documento a
# Proveedor"). Si falta, no se manda nada por Telegram pero el resto del sistema sigue
# funcionando normal.
N8N_WEBHOOK_ENVIAR_DOCUMENTO=
# Webhook del workflow v2 "Enviar Contenido a Proveedor/Cliente" (documentos, fotos y
# texto). Es el que usa el backend; el de arriba (v1) queda solo como respaldo.
N8N_WEBHOOK_ENVIAR_CONTENIDO=
# Webhook de n8n que manda el link de acceso al portal de proveedores/clientes
N8N_WEBHOOK_PORTAL_LOGIN=
# Webhook de n8n (workflow "Notificar Grupo Pronoia") que manda cada acción importante
# del sistema al grupo interno de Telegram. El chat id del grupo se configura en el
# nodo "Config" del workflow, no aquí.
N8N_WEBHOOK_GRUPO=
# Secreto compartido OPCIONAL con n8n: si se define, el backend lo manda en el header
# X-Pronoia-Secret a los 4 webhooks (n8n debe verificarlo). Sin valor no se manda header.
# Fuera de produccion los 4 webhooks de arriba NO tienen URL por defecto (quedan vacios).
N8N_WEBHOOK_SECRET=
# Chat id (negativo, ej. -1001234567890) del grupo "P.S Cajas Pagos", donde el bot manda los
# movimientos de dinero (pagos, cobros, cruces, bancas, notas) con su comprobante y las facturas
# emitidas (mensaje + PDF). Opcional: sin
# valor no se manda nada de dinero a Telegram. Usa N8N_WEBHOOK_ENVIAR_CONTENIDO.
# Opcional: la clave TELEGRAM_CAJAS_CHAT_ID tambien puede estar en la tabla
# public.configuracion_secreta (la variable de entorno tiene prioridad).
TELEGRAM_CAJAS_CHAT_ID=
# 'false' apaga todas las notificaciones al grupo
GRUPO_NOTIFICACIONES=true
# Eventos a silenciar (claves o categorías separadas por coma), ej: maestros,ticket.editado
GRUPO_EVENTOS_SILENCIADOS=
# true = incluir eventos ruidosos (cada pesada de una toma física)
GRUPO_INCLUIR_RUIDOSOS=false
# Zona horaria (IANA) de la hora que se muestra en los mensajes
GRUPO_ZONA_HORARIA=America/Caracas
# Base del portal, para armar el link de acceso que se manda por Telegram
PORTAL_URL=http://localhost:5173
# Opcional — si falta, se deriva de JWT_SECRET (ver env.ts). Solo setear si se quiere
# un secreto totalmente independiente para las sesiones del portal.
PORTAL_JWT_SECRET=
